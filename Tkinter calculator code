"""A simple command-line calculator with history."""

import math


def add(num1, num2):
    return num1 + num2


def subtract(num1, num2):
    return num1 - num2


def multiply(num1, num2):
    return num1 * num2


def divide(num1, num2):
    if num2 == 0:
        raise ZeroDivisionError("Cannot divide by zero.")
    return num1 / num2


def percentage(percent, total):
    return percent * total / 100


def square(num):
    return num ** 2


def square_root(num):
    if num < 0:
        raise ValueError("Cannot calculate the square root of a negative number.")
    return math.sqrt(num)


# Every choice the user can type maps to the function that does the work.
OPERATIONS = {
    "+": add,
    "-": subtract,
    "*": multiply,
    "/": divide,
    "%": percentage,
    "sq": square,
    "²": square,
    "sqrt": square_root,
    "√": square_root,
}

# These operations need only one number.
SINGLE_NUMBER = {"sq", "²", "sqrt", "√"}


def print_menu():
    print("\n=== Calculator ===")
    print("+     add            -     subtract")
    print("*     multiply       /     divide")
    print("%     percent of a total")
    print("sq    square         sqrt  square root")
    print("h     show history   c     clear history")
    print("m     show menu      q     quit")


def show_history(history):
    if not history:
        print("History is empty.")
        return
    for number, entry in enumerate(history, start=1):
        print(f"{number}. {entry}")


def read_number(prompt):
    """Keep asking until the user types a normal number (no nan or inf)."""
    while True:
        try:
            number = float(input(prompt))
        except ValueError:
            print("Invalid input. Please enter a number.")
            continue
        if not math.isfinite(number):
            print("Invalid input. Please enter a normal number.")
            continue
        return number


def run_operation(choice, history):
    """Read the numbers, calculate, print the result, and save it to history."""
    if choice in SINGLE_NUMBER:
        num = read_number("Enter number: ")
        result = OPERATIONS[choice](num)
        entry = f"{num} {choice} = {result}"
    elif choice == "%":
        percent = read_number("Enter percent: ")
        total = read_number("Enter total: ")
        result = percentage(percent, total)
        entry = f"{percent}% of {total} = {result}"
    else:
        num1 = read_number("Enter number 1: ")
        num2 = read_number("Enter number 2: ")
        result = OPERATIONS[choice](num1, num2)
        entry = f"{num1} {choice} {num2} = {result}"

    # Huge results can silently become inf, so we check before using them.
    if not math.isfinite(result):
        raise OverflowError("The result is too large.")

    print(result)
    history.append(entry)


def main():
    history = []
    print_menu()

    while True:
        choice = input("\nEnter your choice: ").strip().lower()

        if choice == "q":
            print("Goodbye!")
            break
        elif choice == "m":
            print_menu()
        elif choice == "h":
            show_history(history)
        elif choice == "c":
            history.clear()
            print("History cleared.")
        elif choice in OPERATIONS:
            try:
                run_operation(choice, history)
            except OverflowError:
                print("Error: the result is too large.")
            except (ValueError, ZeroDivisionError) as error:
                print(f"Error: {error}")
        else:
            print("Not available. Type m to see the menu.")


if __name__ == "__main__":
    main()
    
